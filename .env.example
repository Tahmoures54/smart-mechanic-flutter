# ═══════════════════════════════════════════════════════════
# Smart Mechanic Flutter — Environment Variables (EXAMPLE)
# کپی کنید به .env و مقادیر را تنظیم کنید:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# آدرس پایه API بک‌اند (بدون اسلش انتهایی)
# Production (دامنه رسمی):
API_BASE_URL=https://smart-mec.ir/api
# Liara (ایران):
# API_BASE_URL=https://smart-mec.liara.run/api
# Local emulator Android (backend روی ماشین host):
# API_BASE_URL=http://10.0.2.2:3000/api
# Local iOS simulator:
# API_BASE_URL=http://127.0.0.1:3000/api

# نسخه API
API_VERSION=

# اختیاری
# ENABLE_API_LOGGING=false
