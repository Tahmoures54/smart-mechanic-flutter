# ═══════════════════════════════════════════════════════════
# Smart Mechanic Flutter — Environment Variables
# این فایل در .gitignore است؛ برای تیم از .env.example کپی کنید.
# متغیرهای زیر در کلاینت عمومی‌اند (سکرت واقعی را اینجا نگذارید).
# ═══════════════════════════════════════════════════════════

# آدرس پایه API بک‌اند (بدون اسلش انتهایی)
API_BASE_URL=https://smart-mec-backend-zeta.vercel.app/api

# نسخه API (با rewrite سمت سرور به /api/:path*)
API_VERSION=v1

# اختیاری: فعال‌سازی لاگ شبکه در بیلدهای غیر debug
# ENABLE_API_LOGGING=false
