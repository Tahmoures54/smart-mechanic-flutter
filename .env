# ═══════════════════════════════════════════════════════════
# Smart Mechanic Flutter — Environment Variables
# این فایل در assets باندل می‌شود؛ سکرت واقعی نگذارید.
# ═══════════════════════════════════════════════════════════

# آدرس پایه API بک‌اند (بدون اسلش انتهایی)
# Production روی دامنه رسمی سایت:
API_BASE_URL=https://smart-mec.ir/api

# نسخه API (rewrite سمت سرور: /api/v1/* → /api/*)
API_VERSION=v1

# اختیاری: فعال‌سازی لاگ شبکه در بیلدهای غیر debug
# ENABLE_API_LOGGING=false
